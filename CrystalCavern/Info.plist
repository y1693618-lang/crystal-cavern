<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist — アプリの設定表。

  $(…) のところは Xcode が project.yml の値で埋めます。触らなくて構いません。
  差し替えるのは GADApplicationIdentifier の1か所だけです。
-->
<plist version="1.0">
<dict>

    <!-- ===== 基本 ===== -->
    <!-- 既定の言語。en.lproj/ja.lproj などが無い言語の人にはこれが出ます。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- ホーム画面の名前。言語ごとの名前は *.lproj/InfoPlist.strings 側にあり、
         そちらが優先されます。ここは最後の受け皿です。 -->
    <key>CFBundleDisplayName</key>
    <string>Crystal Cavern</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 対応している言語。CrystalCavern/*.lproj と対になっています。 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ja</string>
        <string>zh-Hans</string>
        <string>ko</string>
        <string>es</string>
    </array>

    <!-- 暗号化の申告。false にしておくと、アップロードのたびに
         「輸出コンプライアンス」を聞かれなくなります。
         このアプリは独自の暗号化を持ちません（HTTPS のみ）。 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- SwiftUI のアプリなので、画面の管理は自前ではしません -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- ===== AdMob ===== -->

    <!-- ▼▼▼ 必須。自分の AdMob アプリ ID に差し替える ▼▼▼
         いまの値は Google のテスト用です。
         入れ忘れると、起動した瞬間にアプリが落ちます（SDK がわざとそうしています）。 -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-3940256099942544~1458002511</string>

    <!-- 追跡許可を求めるときに出る説明文。審査で読まれます。
         言語ごとの文は *.lproj/InfoPlist.strings 側にあります。 -->
    <key>NSUserTrackingUsageDescription</key>
    <string>広告をあなたに合ったものにするために使います。許可しなくてもゲームの内容は変わりません。</string>

    <!-- 広告の成果測定に使われる識別子。多いほど単価が上がりやすくなります。 -->
    <key>SKAdNetworkItems</key>
    <array>
        <dict><key>SKAdNetworkIdentifier</key><string>cstr6suwn9.skadnetwork</string></dict>
        <dict><key>SKAdNetworkIdentifier</key><string>4fzdc2evr5.skadnetwork</string></dict>
        <dict><key>SKAdNetworkIdentifier</key><string>2fnua5tdw4.skadnetwork</string></dict>
        <dict><key>SKAdNetworkIdentifier</key><string>ydx93a7ass.skadnetwork</string></dict>
        <dict><key>SKAdNetworkIdentifier</key><string>p78axxw29g.skadnetwork</string></dict>
