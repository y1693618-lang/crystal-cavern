<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  プライバシーマニフェスト。2024年春から必須になりました。
  これが無いと審査で止まります。

  中身は App Store Connect の「アプリのプライバシー」と同じ5種類に
  そろえてあります。二か所で違うことを言わないためです。
  内訳は Google が AdMob 利用者向けに公開している対応表に従いました。
  （developers.google.com/admob/ios/privacy/data-disclosure）

    デバイスID          広告のため   紐づけあり  トラッキングあり
    広告データ          広告のため   紐づけあり  トラッキングあり
    製品の操作          分析のため   紐づけあり  トラッキングなし
    クラッシュデータ    動作のため   紐づけなし  トラッキングなし
    パフォーマンスデータ 動作のため   紐づけあり  トラッキングなし

  集めているのは同梱した AdMob の SDK で、アプリ自身は何も集めていません。
  ゲームの進行状況は WebView の中（localStorage）にだけ保存され、
  端末の外には出ません。

  UserDefaults も使っています。用途はアプリ自身の設定の読み書きだけです。
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <true/>

    <key>NSPrivacyTrackingDomains</key>
    <array>
        <!--
          AdMob が使うドメイン。下は代表的なものです。
          Mac があれば Xcode の App Privacy Report で実際の通信先を
          確認できますが、この一覧のままでも審査は通ります。
        -->
        <string>googleads.g.doubleclick.net</string>
        <string>pagead2.googlesyndication.com</string>
        <string>googleadservices.com</string>
        <string>google-analytics.com</string>
    </array>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- 広告ID。広告を出すためだけに使われます。 -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>

        <!-- どの広告を見たか。 -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAdvertisingData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>

        <!-- 起動やタップなどの操作。SDK が分析のために見ています。 -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- 落ちたときの記録。 -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- 起動にかかった時間など。 -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePerformanceData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: このアプリ自身の設定を読み書きするため -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
